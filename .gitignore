# ===============================================================
# High Snipping Frames - Git Ignore Configuration
# ===============================================================

# Compiler intermediate outputs & debug artifacts
*.o
*.obj
*.res
*.pdb
*.ilk
*.exp
*.d
*.dmp

# Build, packaging & logs
*.log
*.tmp
*.bak
*.orig
dist/
staging/
_stage/

# Documentation / Research staging (kept local)
docs/

# Python cache & utilities
__pycache__/
*.pyc
*.pyo

# IDE & Editor files
.vscode/
.idea/
.vs/
*.suo
*.user
*.userosscache
*.sln.docstates

# Windows OS generated files
[Dd]esktop.ini
[Tt]humbs.db
$RECYCLE.BIN/
