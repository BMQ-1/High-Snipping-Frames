#include <windows.h>

#ifdef BUILD_GUI
101 ICON "../assets/icon.ico"
1 24 "app.manifest"
#endif

VS_VERSION_INFO VERSIONINFO
FILEVERSION     2,0,0,0
PRODUCTVERSION  2,0,0,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          0x40004L
FILETYPE        0x1L
FILESUBTYPE     0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "High Snipping Frames"
            VALUE "ProductName",      "High Snipping Frames"
            VALUE "ProductVersion",   "2.0.0.0"
            VALUE "FileVersion",      "2.0.0.0"
#ifdef BUILD_GUI
            VALUE "FileDescription",  "High Snipping Frames Control Center"
            VALUE "InternalName",     "HighSnippingFramesGUI.exe"
            VALUE "OriginalFilename", "HighSnippingFramesGUI.exe"
#else
            VALUE "FileDescription",  "Snipping Tool High Framerate Module"
            VALUE "InternalName",     "SnippingToolHighFPS.dll"
            VALUE "OriginalFilename", "SnippingToolHighFPS.dll"
#endif
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
